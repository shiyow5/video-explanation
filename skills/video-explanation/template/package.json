    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.537",
    "@remotion/google-fonts": "4.0.537",
    "@remotion/media": "4.0.537",
    "katex": "0.18.11",
    "lucide-react": "1.50.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.537",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
